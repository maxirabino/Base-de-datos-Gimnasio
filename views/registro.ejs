<%- include('partials/header') %>

<section class="auth-wrap auth-wrap-wide">
  <div class="auth-card card">
    <span class="eyebrow">Sumate al gimnasio</span>
    <h1>Crear cuenta de socio</h1>
    <p class="muted">Completá tus datos y empezá a reservar clases.</p>

    <%- include('partials/errors') %>

    <form method="post" action="/registro" class="stack">
      <div class="form-grid">
        <label>
          Nombre
          <input type="text" name="nombre" value="<%= old.nombre || '' %>" required>
        </label>
        <label>
          Apellido
          <input type="text" name="apellido" value="<%= old.apellido || '' %>" required>
        </label>
        <label>
          DNI
          <input type="text" name="dni" value="<%= old.dni || '' %>" inputmode="numeric" required>
        </label>
        <label>
          Teléfono
          <input type="tel" name="telefono" value="<%= old.telefono || '' %>" placeholder="11 5555-0000">
        </label>
        <label>
          Fecha de nacimiento
          <input type="date" name="fecha_nacimiento" value="<%= old.fecha_nacimiento || '' %>">
        </label>
        <label>
          Email
          <input type="email" name="email" value="<%= old.email || '' %>" required>
        </label>
        <label>
          Contraseña
          <input type="password" name="password" minlength="8" required>
          <small class="muted">Mínimo 8 caracteres.</small>
        </label>
        <label>
          Repetir contraseña
          <input type="password" name="password2" minlength="8" required>
        </label>
      </div>
      <button type="submit" class="btn btn-primary btn-block">Crear cuenta</button>
    </form>

    <p class="auth-alt">¿Ya tenés cuenta? <a href="/login">Ingresá</a></p>
  </div>

  <aside class="auth-side">
    <h2>Tu cuenta de socio incluye</h2>
    <ul class="check-list">
      <li>Reserva y cancelación de clases online.</li>
      <li>Consulta de cupos en tiempo real.</li>
      <li>Historial de cuotas y pagos.</li>
      <li>Acceso desde cualquier dispositivo.</li>
    </ul>
    <p class="muted small">Los usuarios de profesor y administración los crea el gimnasio.</p>
  </aside>
</section>

<%- include('partials/footer') %>
