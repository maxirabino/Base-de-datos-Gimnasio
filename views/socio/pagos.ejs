<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <span class="eyebrow">Membresía</span>
    <h1>Mi membresía</h1>
    <p class="muted">
      <% if (socio.fecha_vencimiento) { %>
        Plan <%= socio.tipo_plan %> · <span class="badge badge-<%= socio.estado_cuota.replace(' ', '-') %>"><%= socio.estado_cuota %></span>
        · vence <%= formatDate(socio.fecha_vencimiento) %>
      <% } else { %>
        Todavía no tenés pagos registrados. Acercate a recepción para activar tu plan.
      <% } %>
    </p>
  </div>
</section>

<%- include('tabs') %>

<% if (pagos.length === 0) { %>
  <div class="empty">No hay pagos registrados todavía.</div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Plan</th><th>Monto</th><th>Método</th><th>Fecha de pago</th><th>Vencimiento</th><th>Estado</th></tr>
      </thead>
      <tbody>
        <% pagos.forEach((p) => { %>
          <tr>
            <td><strong><%= p.tipo_plan %></strong></td>
            <td><%= formatMoney(p.monto_abonado) %></td>
            <td><%= p.metodo_pago || '-' %></td>
            <td><%= formatDate(p.fecha_pago) %></td>
            <td><%= formatDate(p.fecha_vencimiento) %></td>
            <td><span class="badge badge-<%= p.estado %>"><%= p.estado %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="muted small note">Los pagos se registran desde administración. Si ves un error, contactá al gimnasio.</p>
<% } %>

<%- include('../partials/footer') %>
