<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <span class="eyebrow">Área de socios</span>
    <h1>Hola, <%= socio.nombre %>.</h1>
    <p class="muted">Este es el resumen de tu actividad en FitForge.</p>
  </div>
</section>

<%- include('tabs') %>

<section class="stats-grid">
  <article class="stat-card">
    <span class="stat-label">Membresía</span>
    <strong class="stat-text"><%= socio.tipo_plan || 'Sin plan' %></strong>
    <span class="muted small">
      <% if (socio.fecha_vencimiento) { %>
        <span class="badge badge-<%= socio.estado_cuota.replace(' ', '-') %>"><%= socio.estado_cuota %></span>
        · vence <%= formatDate(socio.fecha_vencimiento) %>
      <% } else { %>Sin pagos registrados<% } %>
    </span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Asistencias</span>
    <strong><%= stats.asistencias_30d %></strong>
    <span class="muted small">últimos 30 días</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Rutinas asignadas</span>
    <strong><%= stats.rutinas %></strong>
    <span class="muted small">por tus entrenadores</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Último peso</span>
    <strong><%= stats.peso !== null ? Number(stats.peso) + ' kg' : '-' %></strong>
    <span class="muted small"><%= stats.grasa !== null ? Number(stats.grasa) + ' % de grasa' : 'sin evaluaciones' %></span>
  </article>
</section>

<div class="two-col">
  <section class="panel">
    <div class="panel-head">
      <h2>Mis últimos ingresos</h2>
    </div>
    <% if (ingresos.length === 0) { %>
      <div class="empty">Todavía no registraste ingresos.</div>
    <% } else { %>
      <ul class="class-list">
        <% ingresos.forEach((i) => { %>
          <li>
            <div>
              <strong><%= formatDate(i.fecha) %></strong>
              <span class="muted small"><%= i.nombre_sede %></span>
            </div>
            <div class="class-time">
              <span class="muted small"><%= formatTime(i.hora_ingreso) %> a <%= i.hora_egreso ? formatTime(i.hora_egreso) : '—' %></span>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>Últimos pagos</h2>
      <a class="link" href="/socio/pagos">Ver mi membresía</a>
    </div>
    <% if (ultimosPagos.length === 0) { %>
      <div class="empty">No hay pagos registrados todavía.</div>
    <% } else { %>
      <ul class="payment-list">
        <% ultimosPagos.forEach((p) => { %>
          <li>
            <div>
              <strong>Plan <%= p.tipo_plan %></strong>
              <span class="muted small">Pagado el <%= formatDate(p.fecha_pago) %> · vence <%= formatDate(p.fecha_vencimiento) %></span>
            </div>
            <div class="payment-amount">
              <strong><%= formatMoney(p.monto_abonado) %></strong>
              <span class="badge badge-<%= p.estado %>"><%= p.estado %></span>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
