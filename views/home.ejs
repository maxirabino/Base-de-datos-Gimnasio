<%- include('partials/header') %>

<div class="dot-grid" data-dot-grid aria-hidden="true">
  <canvas class="dot-grid__canvas"></canvas>
</div>

<section class="hero">
  <div class="hero-content">
    <span class="eyebrow">Entrenamiento · Comunidad · Resultados</span>
    <h1>Tu mejor versión empieza <span class="accent">hoy</span>.</h1>
    <p class="lead">
      Clases para todos los niveles, profesores que te acompañan y una comunidad
      que empuja. Elegí tu actividad y reservá tu lugar en segundos.
    </p>
    <div class="hero-actions">
      <% if (currentUser) { %>
        <a class="btn btn-primary" href="<%= panelUrl(currentUser.rol) %>">Ir a mi panel</a>
      <% } else { %>
        <a class="btn btn-primary" href="/registro">Quiero sumarme</a>
        <a class="btn btn-ghost" href="/login">Ya tengo cuenta</a>
      <% } %>
    </div>
    <div class="hero-stats">
      <div><strong><%= stats.socios %></strong><span>socios activos</span></div>
      <div><strong><%= stats.profesores %></strong><span>profesores</span></div>
      <div><strong><%= stats.actividades %></strong><span>actividades</span></div>
    </div>
  </div>
  <div class="hero-card">
    <p class="eyebrow">Empezá en 3 pasos</p>
    <ol class="steps">
      <li><span>1</span> Creá tu cuenta de socio.</li>
      <li><span>2</span> Elegí la actividad y el horario.</li>
      <li><span>3</span> Reservá y vení a entrenar.</li>
    </ol>
    <div class="hero-card-footer">
      <span class="dot"></span> Cupos actualizados en tiempo real
    </div>
  </div>
</section>

<section id="actividades" class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">Nuestra grilla</span>
      <h2>Actividades disponibles</h2>
    </div>
    <p class="muted">Elegí la clase que mejor se adapte a tu ritmo y objetivos.</p>
  </div>

  <% if (actividades.length === 0) { %>
    <div class="empty">Todavía no hay actividades publicadas.</div>
  <% } else { %>
    <div class="grid activity-grid">
      <% actividades.forEach((a) => { %>
        <article class="card activity-card">
          <div class="activity-top">
            <span class="badge badge-day"><%= a.dia_semana %></span>
            <span class="price"><%= formatMoney(a.precio) %></span>
          </div>
          <h3><%= a.nombre %></h3>
          <p class="muted small"><%= a.descripcion %></p>
          <ul class="meta">
            <li><span>Profesor</span> <%= a.profesor %></li>
            <li><span>Horario</span> <%= formatTime(a.hora_inicio) %> a <%= formatTime(a.hora_fin) %></li>
            <li><span>Sala</span> <%= a.sala %></li>
            <li><span>Cupo</span> <%= a.inscriptos %> / <%= a.cupo %> lugares</li>
          </ul>
          <% if (currentUser && currentUser.rol === 'socio') { %>
            <a class="btn btn-small btn-primary" href="/socio/actividades">Reservar</a>
          <% } else { %>
            <a class="btn btn-small" href="/registro">Quiero sumarme</a>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="section features">
  <article class="feature">
    <h3>Profesores con experiencia</h3>
    <p>Clases guiadas, corrección de técnica y planes adaptados a cada nivel.</p>
  </article>
  <article class="feature">
    <h3>Reservas simples</h3>
    <p>Desde tu panel ves cupos, reservás y cancelás sin llamar ni escribir.</p>
  </article>
  <article class="feature">
    <h3>Cuotas claras</h3>
    <p>Consultá tu historial de pagos y las cuotas pendientes cuando quieras.</p>
  </article>
</section>

<section class="cta-banner">
  <div>
    <h2>¿Listo para arrancar?</h2>
    <p>Creá tu cuenta gratis y reservá tu primera clase hoy mismo.</p>
  </div>
  <a class="btn btn-primary" href="/registro">Crear mi cuenta</a>
</section>

<script type="module" src="/js/dot-grid.js"></script>
<%- include('partials/footer') %>
