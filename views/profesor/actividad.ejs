<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <span class="eyebrow">Detalle de clase</span>
    <h1><%= actividad.nombre %></h1>
    <p class="muted"><%= actividad.descripcion || 'Sin descripción.' %></p>
  </div>
  <a class="btn btn-ghost" href="/profesor">Volver al panel</a>
</section>

<section class="info-grid">
  <article class="info-card">
    <span class="muted small">Día y horario</span>
    <strong><%= actividad.dia_semana %> · <%= formatTime(actividad.hora_inicio) %> a <%= formatTime(actividad.hora_fin) %></strong>
  </article>
  <article class="info-card">
    <span class="muted small">Sala</span>
    <strong><%= actividad.sala %></strong>
  </article>
  <article class="info-card">
    <span class="muted small">Cupo</span>
    <strong><%= actividad.inscriptos %> / <%= actividad.cupo %> lugares</strong>
  </article>
  <article class="info-card">
    <span class="muted small">Precio</span>
    <strong><%= formatMoney(actividad.precio) %></strong>
  </article>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Alumnos inscriptos</h2>
    <span class="badge badge-<%= actividad.activa ? 'activa' : 'inactiva' %>">
      <%= actividad.activa ? 'actividad activa' : 'actividad inactiva' %>
    </span>
  </div>

  <% if (alumnos.length === 0) { %>
    <div class="empty">Todavía no hay alumnos inscriptos en esta clase.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Alumno/a</th>
            <th>DNI</th>
            <th>Teléfono</th>
            <th>Reserva</th>
          </tr>
        </thead>
        <tbody>
          <% alumnos.forEach((a) => { %>
            <tr>
              <td><strong><%= a.nombre %> <%= a.apellido %></strong></td>
              <td><%= a.dni %></td>
              <td><%= a.telefono || '-' %></td>
              <td><%= formatDateTime(a.fecha_reserva) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
