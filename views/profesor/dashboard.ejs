<%- include('../partials/header') %>

<% const activas = actividades.filter((a) => a.activa).length; %>
<% const totalAlumnos = actividades.reduce((total, a) => total + Number(a.inscriptos), 0); %>

<section class="page-head">
  <div>
    <span class="eyebrow">Área de profesores</span>
    <h1>Hola, profe <%= profesor.nombre %>.</h1>
    <p class="muted"><%= profesor.especialidad %></p>
  </div>
</section>

<section class="stats-grid stats-grid-3">
  <article class="stat-card">
    <span class="stat-label">Clases activas</span>
    <strong><%= activas %></strong>
    <span class="muted small">de <%= actividades.length %> asignadas</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Alumnos inscriptos</span>
    <strong><%= totalAlumnos %></strong>
    <span class="muted small">reservas confirmadas</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Especialidad</span>
    <strong class="stat-text"><%= profesor.especialidad %></strong>
    <span class="muted small">perfil profesional</span>
  </article>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Mis actividades</h2>
  </div>

  <% if (actividades.length === 0) { %>
    <div class="empty">Todavía no tenés actividades asignadas.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Actividad</th>
            <th>Día y horario</th>
            <th>Sala</th>
            <th>Cupo</th>
            <th>Precio</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% actividades.forEach((a) => { %>
            <tr>
              <td><strong><%= a.nombre %></strong></td>
              <td><%= a.dia_semana %> · <%= formatTime(a.hora_inicio) %> a <%= formatTime(a.hora_fin) %></td>
              <td><%= a.sala %></td>
              <td><%= a.inscriptos %> / <%= a.cupo %></td>
              <td><%= formatMoney(a.precio) %></td>
              <td>
                <span class="badge badge-<%= a.activa ? 'activa' : 'inactiva' %>">
                  <%= a.activa ? 'activa' : 'inactiva' %>
                </span>
              </td>
              <td class="right">
                <a class="btn btn-small" href="/profesor/actividades/<%= a.id %>">Ver alumnos</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
