<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <span class="eyebrow">Administración</span>
    <h1>Profesores</h1>
    <p class="muted">Creá cuentas de profesor y consultá su carga de clases.</p>
  </div>
</section>

<%- include('tabs') %>

<section class="panel">
  <div class="panel-head">
    <h2>Nuevo profesor</h2>
    <span class="muted small">La cuenta se crea con rol profesor.</span>
  </div>

  <%- include('../partials/errors') %>

  <form method="post" action="/admin/profesores" class="stack">
    <div class="form-grid form-grid-3">
      <label>
        Nombre
        <input type="text" name="nombre" value="<%= old.nombre || '' %>" required>
      </label>
      <label>
        Apellido
        <input type="text" name="apellido" value="<%= old.apellido || '' %>" required>
      </label>
      <label>
        DNI
        <input type="text" name="dni" value="<%= old.dni || '' %>" required>
      </label>
      <label>
        Teléfono
        <input type="tel" name="telefono" value="<%= old.telefono || '' %>">
      </label>
      <label>
        Especialidad
        <input type="text" name="especialidad" value="<%= old.especialidad || '' %>" placeholder="Funcional, Yoga..." required>
      </label>
      <label>
        Email
        <input type="email" name="email" value="<%= old.email || '' %>" required>
      </label>
      <label>
        Contraseña inicial
        <input type="password" name="password" minlength="8" required>
        <small class="muted">Mínimo 8 caracteres.</small>
      </label>
    </div>
    <button type="submit" class="btn btn-primary">Crear profesor</button>
  </form>
</section>

<section class="panel">
  <div class="panel-head">
    <h2><%= profesores.length %> profesores</h2>
  </div>

  <% if (profesores.length === 0) { %>
    <div class="empty">Todavía no hay profesores registrados.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Profesor</th>
            <th>DNI</th>
            <th>Especialidad</th>
            <th>Contacto</th>
            <th>Contratación</th>
            <th>Actividades</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% profesores.forEach((p) => { %>
            <tr>
              <td>
                <strong><%= p.nombre %> <%= p.apellido %></strong>
                <span class="muted small block"><%= p.email %></span>
              </td>
              <td><%= p.dni %></td>
              <td><%= p.especialidad %></td>
              <td><%= p.telefono || '-' %></td>
              <td><%= formatDate(p.fecha_contratacion) %></td>
              <td><%= p.actividades %></td>
              <td>
                <span class="badge badge-<%= p.activo ? 'activa' : 'inactiva' %>"><%= p.activo ? 'activo' : 'inactivo' %></span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
