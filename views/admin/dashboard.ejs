<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <span class="eyebrow">Administración</span>
    <h1>Resumen general</h1>
    <p class="muted">Estado del gimnasio, membresías e ingresos.</p>
  </div>
  <div class="hero-actions">
    <a class="btn btn-primary" href="/admin/pagos">Registrar pago</a>
    <a class="btn btn-ghost" href="/admin/ingresos">Registrar ingreso</a>
  </div>
</section>

<%- include('tabs') %>

<section class="stats-grid">
  <article class="stat-card">
    <span class="stat-label">Socios</span>
    <strong><%= stats.socios %></strong>
    <span class="muted small"><%= stats.vigentes %> con cuota vigente</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Cuotas vencidas o sin pagos</span>
    <strong><%= stats.socios - stats.vigentes %></strong>
    <span class="muted small">socios a regularizar</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Entrenadores</span>
    <strong><%= stats.entrenadores %></strong>
    <span class="muted small">en el equipo</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Rutinas</span>
    <strong><%= stats.rutinas %></strong>
    <span class="muted small">en el catálogo</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Ingresos de hoy</span>
    <strong><%= stats.ingresos_hoy %></strong>
    <span class="muted small">en todas las sedes</span>
  </article>
  <article class="stat-card">
    <span class="stat-label">Recaudado este mes</span>
    <strong><%= formatMoney(stats.recaudado_mes) %></strong>
    <span class="muted small">pagos de membresías</span>
  </article>
</section>

<div class="two-col">
  <section class="panel">
    <div class="panel-head">
      <h2>Últimos ingresos</h2>
      <a class="link" href="/admin/ingresos">Ver todos</a>
    </div>
    <% if (ingresos.length === 0) { %>
      <div class="empty">No hay ingresos registrados.</div>
    <% } else { %>
      <ul class="class-list">
        <% ingresos.forEach((i) => { %>
          <li>
            <div>
              <strong><%= i.socio %></strong>
              <span class="muted small"><%= i.nombre_sede %></span>
            </div>
            <div class="class-time">
              <span class="badge badge-day"><%= formatDate(i.fecha) %></span>
              <span class="muted small"><%= formatTime(i.hora_ingreso) %> a <%= i.hora_egreso ? formatTime(i.hora_egreso) : '—' %></span>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="panel">
    <div class="panel-head">
      <h2>Últimos pagos</h2>
      <a class="link" href="/admin/pagos">Ver pagos</a>
    </div>
    <% if (pagos.length === 0) { %>
      <div class="empty">No hay pagos registrados.</div>
    <% } else { %>
      <ul class="payment-list">
        <% pagos.forEach((p) => { %>
          <li>
            <div>
              <strong><%= p.socio %></strong>
              <span class="muted small">Plan <%= p.tipo_plan %> · vence <%= formatDate(p.fecha_vencimiento) %></span>
            </div>
            <div class="payment-amount">
              <strong><%= formatMoney(p.monto_abonado) %></strong>
              <span class="muted small"><%= formatDate(p.fecha_pago) %></span>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
