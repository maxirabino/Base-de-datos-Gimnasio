<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <span class="eyebrow">Administración</span>
    <h1>Pagos y cuotas</h1>
    <p class="muted">Registrá cuotas, pagos y regularizá deudas.</p>
  </div>
</section>

<%- include('tabs') %>

<section class="panel">
  <div class="panel-head">
    <h2>Registrar cuota o pago</h2>
  </div>

  <%- include('../partials/errors') %>

  <form method="post" action="/admin/pagos" class="stack">
    <div class="form-grid form-grid-3">
      <label>
        Socio
        <select name="socio_id" required>
          <option value="">Seleccionar...</option>
          <% socios.forEach((s) => { %>
            <option value="<%= s.id %>" <%= String(old.socio_id) === String(s.id) ? 'selected' : '' %>>
              <%= s.nombre %> · DNI <%= s.dni %>
            </option>
          <% }) %>
        </select>
      </label>
      <label>
        Concepto
        <input type="text" name="concepto" value="<%= old.concepto || '' %>" placeholder="Cuota noviembre" required>
      </label>
      <label>
        Monto
        <input type="number" name="monto" min="0.01" step="0.01" value="<%= old.monto ?? '' %>" required>
      </label>
      <label>
        Método de pago
        <select name="metodo_pago">
          <option value="">Sin especificar</option>
          <% ['Efectivo', 'Tarjeta', 'Transferencia'].forEach((m) => { %>
            <option value="<%= m %>" <%= old.metodo_pago === m ? 'selected' : '' %>><%= m %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Fecha de pago
        <input type="date" name="fecha_pago" value="<%= old.fecha_pago || '' %>">
      </label>
      <label>
        Vencimiento
        <input type="date" name="fecha_vencimiento" value="<%= old.fecha_vencimiento || '' %>">
      </label>
      <label>
        Estado
        <select name="estado">
          <% estados.forEach((estado) => { %>
            <option value="<%= estado %>" <%= (old.estado || 'pendiente') === estado ? 'selected' : '' %>><%= estado %></option>
          <% }) %>
        </select>
      </label>
    </div>
    <button type="submit" class="btn btn-primary">Registrar</button>
  </form>
</section>

<section class="panel">
  <div class="panel-head">
    <h2><%= pagos.length %> movimientos</h2>
  </div>

  <% if (pagos.length === 0) { %>
    <div class="empty">Todavía no hay pagos registrados.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Socio</th>
            <th>Concepto</th>
            <th>Monto</th>
            <th>Método</th>
            <th>Vencimiento</th>
            <th>Pago</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% pagos.forEach((p) => { %>
            <tr>
              <td>
                <strong><%= p.socio %></strong>
                <span class="muted small block">DNI <%= p.dni %></span>
              </td>
              <td><%= p.concepto %></td>
              <td><%= formatMoney(p.monto) %></td>
              <td><%= p.metodo_pago || '-' %></td>
              <td><%= formatDate(p.fecha_vencimiento) %></td>
              <td><%= p.fecha_pago ? formatDate(p.fecha_pago) : '-' %></td>
              <td><span class="badge badge-<%= p.estado %>"><%= p.estado %></span></td>
              <td class="right">
                <% if (p.estado !== 'pagado') { %>
                  <form method="post" action="/admin/pagos/<%= p.id %>/pagar">
                    <button type="submit" class="btn btn-small">Marcar pagado</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
