<%- include('../partials/header') %>

<section class="page-head">
  <div>
    <span class="eyebrow">Grilla de clases</span>
    <h1>Actividades</h1>
    <p class="muted">Reservá tu lugar en las clases disponibles.</p>
  </div>
</section>

<nav class="tabs">
  <a class="<%= active === 'resumen' ? 'active' : '' %>" href="/socio">Resumen</a>
  <a class="<%= active === 'actividades' ? 'active' : '' %>" href="/socio/actividades">Actividades</a>
  <a class="<%= active === 'reservas' ? 'active' : '' %>" href="/socio/reservas">Mis reservas</a>
  <a class="<%= active === 'pagos' ? 'active' : '' %>" href="/socio/pagos">Mis cuotas</a>
</nav>

<% if (actividades.length === 0) { %>
  <div class="empty">No hay actividades disponibles por el momento.</div>
<% } else { %>
  <div class="grid activity-grid">
    <% actividades.forEach((a) => { const libres = a.cupo - a.inscriptos; %>
      <article class="card activity-card">
        <div class="activity-top">
          <span class="badge badge-day"><%= a.dia_semana %></span>
          <span class="price"><%= formatMoney(a.precio) %></span>
        </div>
        <h3><%= a.nombre %></h3>
        <p class="muted small"><%= a.descripcion %></p>
        <ul class="meta">
          <li><span>Profesor</span> <%= a.profesor %></li>
          <li><span>Horario</span> <%= formatTime(a.hora_inicio) %> a <%= formatTime(a.hora_fin) %></li>
          <li><span>Sala</span> <%= a.sala %></li>
          <li><span>Cupo</span> <%= a.inscriptos %> / <%= a.cupo %> lugares</li>
        </ul>

        <% if (a.mi_estado === 'confirmada') { %>
          <div class="reserve-row">
            <span class="badge badge-confirmada">Reservada</span>
            <form method="post" action="/socio/reservas/<%= a.mi_inscripcion_id %>/cancelar">
              <input type="hidden" name="redirect" value="/socio/actividades">
              <button type="submit" class="btn btn-small btn-ghost">Cancelar</button>
            </form>
          </div>
        <% } else if (libres <= 0) { %>
          <button type="button" class="btn btn-small" disabled>Sin cupo</button>
        <% } else { %>
          <form method="post" action="/socio/reservas/<%= a.id %>">
            <button type="submit" class="btn btn-small btn-primary">Reservar lugar</button>
          </form>
        <% } %>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
